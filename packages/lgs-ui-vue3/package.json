{
  "name": "@liuguangsen0409/vue3-components-library",
  "version": "0.0.1",
  "description": "A Vue 3 component library based on Element Plus",
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "dist/theme/**"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./es/components/*": {
      "import": "./dist/es/components/*/index.mjs"
    },
    "./lib/components/*": {
      "require": "./dist/lib/components/*/index.js"
    },
    "./theme/*": "./dist/theme/*",
    "./dist/theme/index.css": "./dist/theme/index.css",
    "./resolver": {
      "import": "./dist/resolver.mjs",
      "require": "./dist/resolver.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "element-plus": "^2.7.0"
  }
}
